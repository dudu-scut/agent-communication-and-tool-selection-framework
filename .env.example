# ============================================================================
# NexusAI 环境配置
# ============================================================================
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# 服务启动时自动加载项目根目录下的 .env 文件。
# ============================================================================

# --- LLM / AI 模型 ---
# DeepSeek API 密钥，从 https://platform.deepseek.com 获取
LLM_API_KEY=sk-your-api-key-here
# 模型名称，如 deepseek-v4-flash（快速）或 deepseek-v4-pro（更强）
LLM_MODEL=deepseek-v4-flash
# LLM API 完整端点地址（OpenAI 兼容格式，直接作为 completions endpoint 使用）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
EMBEDDING_API_URL=https://api.deepseek.com/v1/embeddings
EMBEDDING_MODEL=deepseek-v4-pro

# --- 服务端口 ---
RPC_SERVER_PORT=50051
ORCHESTRATOR_PORT=5000
REGISTRY_PORT=8500

# --- 服务地址 ---
ORCHESTRATOR_URL=http://localhost:5000
REGISTRY_URL=http://localhost:8500

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- 路由调优 ---
ROUTING_HIGH_THRESHOLD=0.85
ROUTING_LOW_THRESHOLD=0.50

# --- 超时（秒） ---
REQUEST_TIMEOUT=60
LLM_TIMEOUT=30
A2A_TIMEOUT=30

# --- 日志 ---
# --- Docker Compose / WSL2 platform path ---
# Compose supplies these values to PostgreSQL and uses service DNS internally.
POSTGRES_DB=nexusai
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=nexusai-dev-password

# Local Node proxy defaults. Docker Compose sets GRPC_TARGET=rpc-server:50051.
PROXY_PORT=8081
GRPC_TARGET=localhost:50051

# Compose mounts the bootstrap-generated development certificate by default.
FRONTEND_TLS_CERT_FILE=./certs/dev/frontend-cert.pem
FRONTEND_TLS_KEY_FILE=./certs/dev/frontend-key.pem

# MCP/RAG is an opt-in CMake module, not part of the default build.
ENABLE_MCP=OFF

LOG_LEVEL=INFO

# This development password is local-only; production must inject a managed secret.
# PostgresStore/db_migrate read only these names (Compose maps them to service DNS).
NEXUSAI_POSTGRES_HOST=127.0.0.1
NEXUSAI_POSTGRES_PORT=5432
NEXUSAI_POSTGRES_DATABASE=nexusai
NEXUSAI_POSTGRES_USER=nexusai
NEXUSAI_POSTGRES_PASSWORD=nexusai-dev-password

# The POSTGRES_* names above are consumed by Compose's postgres service.
